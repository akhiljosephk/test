{
  "name": "mapledesk-broker",
  "version": "1.0.0",
  "private": true,
  "description": "Single-broker CRM with persistent workflows and Gmail/WhatsApp integration adapters",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "check": "node scripts/check.js",
    "export": "node scripts/export.js",
    "test": "npm run test:unit && npm run test:workspace && npm run test:prototype",
    "setup:local": "node scripts/init-local.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test:unit": "node --test tests/backend.test.js",
    "test:workspace": "node tests/workspace.cjs",
    "test:prototype": "node tests/prototype.cjs",
    "test:container": "node tests/container.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "otpauth": "^9.5.2",
    "zod": "^4.6.7"
  }
}
