# Copy to .env and supply values privately. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# Required by Caddy in Docker production deployments:
APP_DOMAIN=
BUSINESS_NAME=Your insurance brokerage
BUSINESS_TIMEZONE=America/Toronto
DB_PATH=./data/mapledesk.sqlite
# 64 hex characters, generated locally; required for encrypted OAuth credentials/backups
DATA_KEY=
# Set these temporarily for initial provisioning only, or use npm run setup:local.
OWNER_EMAIL=
OWNER_PASSWORD=
# Base32 authenticator seed: required in production. Enter securely; never in chat.
OWNER_TOTP_SECRET=
MESSAGING_MODE=mock
ALLOW_LIVE_SENDS=false
# Google OAuth web application; redirect: PUBLIC_URL/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ADDRESS=
# Meta business API credentials (not WhatsApp Business phone-app credentials)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Set a currently supported Graph API version after checking Meta's documentation.
WHATSAPP_GRAPH_VERSION=
# Include only templates actually approved on this business account.
# Example shape: [{"name":"approved_name","language":"en","body":"Hi {{1}}, your policy expires on {{2}}.","parameters":["First name","Expiry date"]}]
WHATSAPP_TEMPLATES_JSON=[]
# Optional encrypted off-instance backups (instance IAM role; no static AWS keys)
AWS_REGION=ca-central-1
BACKUP_BUCKET=
BACKUP_PREFIX=mapledesk/
